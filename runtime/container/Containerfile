ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake ninja-build ccache git python3-pip pkg-config binutils curl xz-utils \
    libboost-program-options-dev libboost-filesystem-dev libboost-iostreams-dev \
    libopenscenegraph-dev libcollada-dom-dev libbullet-dev libsdl2-dev libopenal-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
    libyaml-cpp-dev libluajit-5.1-dev liblz4-dev libicu-dev libsqlite3-dev \
    libfreetype-dev libpng-dev libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev \
    libweston-13-dev libva-dev libx264-dev libopus-dev libssl-dev zlib1g-dev nasm \
    lua5.4 make autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*
ENV CCACHE_DIR=/work/cache/ccache PYTHONDONTWRITEBYTECODE=1
WORKDIR /src

FROM ${RUNTIME_BASE_IMAGE} AS runtime
LABEL org.opencontainers.image.source="https://github.com/incident201/AstraBridgeForOpenMW" \
      org.opencontainers.image.description="AstraBridge container runtime for modified OpenMW" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"
# Stable components have separate content-addressed layers. Release identity is last.
COPY stage/python/ /opt/astrabridge/python/
COPY stage/bin/ffmpeg stage/bin/ffprobe /opt/astrabridge/bin/
COPY stage/bin/mediamtx /opt/astrabridge/bin/
COPY stage/engine/ /opt/astrabridge/engine/
COPY stage/LICENSES/ /opt/astrabridge/LICENSES/
COPY stage/runtime/ /opt/astrabridge/runtime/
COPY stage/VERSION.json stage/runtime-manifest.json /opt/astrabridge/
RUN dpkg-query -W '-f=${Package}=${Version}\n' > /opt/astrabridge/runtime-packages.txt \
    && python3 -c "import json,hashlib; from pathlib import Path; p=Path('/opt/astrabridge/runtime-manifest.json'); m=json.loads(p.read_text()); m['packages_sha256']=hashlib.sha256(p.with_name('runtime-packages.txt').read_bytes()).hexdigest(); p.write_text(json.dumps(m,indent=2)+'\n')"
ENV PYTHONPATH=/opt/astrabridge/runtime/daemon \
    ASTRA_INSTALLATION=/opt/astrabridge ASTRA_STORAGE=/data \
    ASTRA_FFMPEG=/opt/astrabridge/bin/ffmpeg ASTRA_MODE=production \
    XDG_RUNTIME_DIR=/tmp/astra-display SDL_VIDEODRIVER=x11 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/astrabridge
EXPOSE 18770/tcp 18771/tcp
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/astrabridge/python/bin/python", "-m", "astra_daemon"]
