# Build against glibc 2.35; the user's host never installs these packages.
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates software-properties-common gnupg \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update
RUN apt-get install -y --no-install-recommends \
    g++-14 cmake ninja-build git python3 python3-pip pkg-config binutils \
    libboost-program-options-dev libboost-filesystem-dev libboost-iostreams-dev \
    libopenscenegraph-dev libcollada-dom-dev libbullet-dev \
    libsdl2-dev libopenal-dev libavcodec-dev libavformat-dev libavutil-dev \
    libswscale-dev libswresample-dev libyaml-cpp-dev libluajit-5.1-dev \
    liblz4-dev libicu-dev libsqlite3-dev libfreetype-dev libpng-dev \
    libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxcb-composite0 \
    xdotool tar gzip \
    && rm -rf /var/lib/apt/lists/*
ENV CC=gcc-14 CXX=g++-14 ASTRA_BUILD_CONTAINER=1
WORKDIR /src
