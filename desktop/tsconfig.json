{
  "compilerOptions": {
    "target":"ES2022", "module":"ESNext", "moduleResolution":"Bundler",
    "strict":true, "allowJs":true, "checkJs":false, "skipLibCheck":true,
    "esModuleInterop":true, "resolveJsonModule":true, "allowImportingTsExtensions":true,
    "types":["node"], "lib":["ES2022","DOM","DOM.Iterable"], "noEmit":true
  },
  "include":["main/**/*.ts","preload/**/*.ts","frontend/**/*.ts","frontend/**/*.svelte","tests/**/*.ts"]
}
